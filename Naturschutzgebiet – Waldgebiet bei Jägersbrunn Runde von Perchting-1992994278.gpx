  <wpt lat="47.983562" lon="11.279894">
    <ele>680</ele>
    <name>Nature reserve near Seeshaupt</name>
    <cmt>https://d2exd72xrrp1s7.cloudfront.net/www/000/1k3/rv/rvekqshoc0i8r09kzhr27gtt32fuc9uf-uhi7187324/0</cmt>
    <desc>TomB: Schön anzusehen - aber bitte aus der Ferne
――――――――――
Nicole 💫: Schöner Sonnenuntergang
――――――――――
Christoph Stoffel Bö: Toller Sonnenuntergang über dem See</desc>
    <src>Komoot</src>
    <link href="https://www.komoot.de/highlight/913554">
