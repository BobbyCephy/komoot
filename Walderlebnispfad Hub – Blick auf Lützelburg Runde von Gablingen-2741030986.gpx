  <wpt lat="48.459686" lon="10.78443">
    <ele>524</ele>
    <name>Lürzelburg Water Tower</name>
    <cmt>https://d2exd72xrrp1s7.cloudfront.net/www/000/1k6/1h/1hkv5wl8kdfpi7ahjo02f58gq42iskxrw-uhi46573584/0</cmt>
    <desc>breddy: Der Wasserturm von Lürzelburg ist das inoffizielle Wahrzeichen der Gemeinde und fester Bestanteil als Festort, wenn der Ort feiert.
――――――――――
Joschi: Im Gespräch war, ob der alte Wasserturm als Standort für eine Antenne für den Digitalfunk von Polizei und Rettungskräften verfügbar sei?</desc>
    <src>Komoot</src>
    <link href="https://www.komoot.de/highlight/3785220">
      <text>View POI on Komoot</text>
    </link>
    <type>Highlight</type>
  </wpt>
