  <wpt lat="46.407653" lon="11.575376">
    <ele>1553.6</ele>
    <name>View of Latemar</name>
    <cmt>https://d2exd72xrrp1s7.cloudfront.net/www/000/1k6/qk/qkcemqxr9d8ukywdpbg2rmsd49fnk4iw-uhi52729139/0</cmt>
    <desc>Angela Pulliero: Da questo punto che funge da crocevia tra sentieri si gode di una magnifica vista panoramica sulle maestose cime del Latemar.</desc>
