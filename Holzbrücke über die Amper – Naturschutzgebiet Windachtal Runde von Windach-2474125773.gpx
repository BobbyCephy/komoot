    <ele>563.6</ele>
    <name>Windach Town Hall (Formerly Schloss Windach)</name>
    <cmt>https://d2exd72xrrp1s7.cloudfront.net/www/000/1k2/k3/k3b84dt2ghgdilazfna20a2v2kikzgx6-uhi2538174/0</cmt>
