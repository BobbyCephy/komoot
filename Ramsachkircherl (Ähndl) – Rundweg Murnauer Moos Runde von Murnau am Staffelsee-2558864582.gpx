  <wpt lat="47.666121" lon="11.185541">
    <name>Ähndl</name>
    <cmt></cmt>
    <desc>aehndl.de, +49 8841 5241, 2 , Murnau a. Staffelsee, 82418, DE, July-September, Tuesday-Sunday: 12PM-8PM
