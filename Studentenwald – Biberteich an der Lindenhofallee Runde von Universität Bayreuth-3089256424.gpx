  <wpt lat="49.908698" lon="11.575132">
    <ele>437</ele>
    <name>Stone Wayside Shrine</name>
    <cmt>https://d2exd72xrrp1s7.cloudfront.net/www/000/1k9/x6/x6a8i82r0h63cm42lwd5mnh35agmyufy-uhi83498480/0</cmt>
    <desc>Gehlee: Scheinbar relativ neues Marterl. Der Grund dafür wird nicht genannt. Schön!</desc>
    <src>Komoot</src>
    <link href="https://www.komoot.de/highlight/7281698">
      <text>View POI on Komoot</text>
    </link>
