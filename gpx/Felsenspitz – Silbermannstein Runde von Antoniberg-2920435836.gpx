  <wpt lat="48.735398" lon="11.060072">
    <ele>412</ele>
    <name>Scenic Forest Path</name>
    <cmt>https://d2exd72xrrp1s7.cloudfront.net/www/000/1k6/1r/1r84gueer6xbq11mt2vc5z79s742yqq2gi-uhi46906084/0</cmt>
