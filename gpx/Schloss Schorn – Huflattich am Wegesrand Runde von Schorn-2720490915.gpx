  <wpt lat="48.59763" lon="11.09812">
    <ele>404.9</ele>
    <name>Schorn Castle</name>
    <cmt>https://d2exd72xrrp1s7.cloudfront.net/www/000/1k8/13/13mpyeux4qmmr1mjqzwixj3xz351uhf7ax-uhi75278906/0</cmt>
    <desc>Mareike: Das Schloss hat seinen Ursprung Ende des 18. Jahrhunderts. Seit dem Ende des 19. Jahrhunderts bis heute ist es in Besitz der Freiherrn von Herman. Das Schloss und sein Garten werden nur zu Veranstaltungen für Besucher geöffnet.
――――――――――
Monal: Ist leider privat,  da </desc>
    <src>Komoot</src>
    <link href="https://www.komoot.de/highlight/6804209">
      <text>View POI on Komoot</text>
    </link>
    <type>Highlight</type>
  </wpt>
