    <ele>380.8</ele>
    <name>Fox Mill Chapel</name>
    <cmt>https://d2exd72xrrp1s7.cloudfront.net/www/000/1k7/4n/4nu5b3uo8srx1lme6tqa5h3nu4tx5eyww-uhi67984496/0</cmt>
