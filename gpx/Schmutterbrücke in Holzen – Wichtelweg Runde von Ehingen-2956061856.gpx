  <wpt lat="48.608802" lon="10.81572">
    <ele>465.8</ele>
    <name>Picnic area on the Schmutter River</name>
    <cmt>https://d2exd72xrrp1s7.cloudfront.net/www/000/1k9/14/1448ubrif7lbg4869wg1dk1of5ab0p92d-uhi83366937/0</cmt>
    <desc>Chris Zäpfle: Schönes Plätzchen an der Schmutter</desc>
    <src>Komoot</src>
    <link href="https://www.komoot.de/highlight/7274376">
      <text>View POI on Komoot</text>
    </link>
    <type>Highlight</type>
