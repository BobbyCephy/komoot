  <wpt lat="48.614211" lon="10.769644">
    <ele>482.9</ele>
    <name>Fishpond with Wooden Cabin</name>
    <cmt>https://d2exd72xrrp1s7.cloudfront.net/www/000/1k5/1r/1rbkh16ykfnj0letgxircqv7w3udt5a3n-uhi37376736/0</cmt>
