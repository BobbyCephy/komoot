    <ele>450</ele>
    <name>Old Local Railway Line and Rest Area Wertingen</name>
    <cmt>https://d2exd72xrrp1s7.cloudfront.net/www/000/1k5/5e/5eutv6x3n6fyx9r9rnuitdy33sd4bnsg-uhi34255767/0</cmt>
    <desc></desc>
