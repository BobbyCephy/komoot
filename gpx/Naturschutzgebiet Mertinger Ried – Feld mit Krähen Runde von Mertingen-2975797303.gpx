  </wpt>
  <wpt lat="48.668488" lon="10.752666">
    <ele>444</ele>
    <name>Information About Mertinger Höll</name>
    <cmt>https://d2exd72xrrp1s7.cloudfront.net/www/000/1k5/1n/1n23wfe2lqc6713jn65bht27ed3sd472ai-uhi34255559/0</cmt>
