  <metadata>
    <name>Ausblick am Hunau-Turm – Hunau Hütte Runde von Felsbastion Hollenhaus</name>
    <desc>Distance: 12.653km, Estimated duration: 3.69h, Elevation up: 350.94963646136284m, Elevation down: 350.94963646136284m, Grade: moderate</desc>
