  <metadata>
    <name>Rund ums Kloster Holzen – Lauschtouren in Bayerisch-Schwaben</name>
    <desc>Distance: 4.764km, Estimated duration: 0.66h, Elevation up: 48.98725474098501m, Elevation down: 53.79923376688197m, Grade: easy</desc>
