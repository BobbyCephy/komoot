      <text>View POI on Komoot</text>
    </link>
    <type>Highlight</type>
  </wpt>
  <wpt lat="47.997723" lon="10.658021">
    <ele>683.2</ele>
    <name>Wanderer's Rest</name>
    <cmt>https://d2exd72xrrp1s7.cloudfront.net/www/000/1k4/r1/r1ulktsbn9fi134py96zf40rc3m0ee3xg-uhi26925104/0</cmt>
    <desc></desc>
