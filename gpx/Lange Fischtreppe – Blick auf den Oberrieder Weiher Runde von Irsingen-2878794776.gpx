  <wpt lat="48.0233" lon="10.65093">
    <name>Parking</name>
    <cmt></cmt>
    <desc>Free</desc>
    <src>Komoot</src>
    <type>POI</type>
  </wpt>
  <wpt lat="48.025175" lon="10.654011">
    <ele>660.2</ele>
    <name>Wertachstausee Dam</name>
    <cmt>https://d2exd72xrrp1s7.cloudfront.net/www/000/1k8/aq/aqw19sae57jwquh5tz08gj6752u413t0-uhi76554498/0</cmt>
    <desc>Johannes: Stauwehr des Wertachstausees. Rechts daneben gibt es einen kleinen Bach als Umgehung für die Fische. Daneben führt ein Fußweg zur Landzunge. Kleine Kletterpartie um da hinzukommen.</desc>
    <src>Komoot</src>
    <link href="https://www.komoot.de/highlight/6884597">
      <text>View POI on Komoot</text>
    </link>
    <type>Highlight</type>
  </wpt>
  <wpt lat="48.024513" lon="10.654405">
    <ele>613</ele>
    <name>Long Fish Ladder</name>
    <cmt>https://d2exd72xrrp1s7.cloudfront.net/www/000/1k6/1c/1c2177nikb3071n5mn7ju6zg1543sudeqf-uhi47566790/0</cmt>
    <desc>Werner Wimmer: erstaunliches "Bauwerk", sehr markant
――――――――――
Johannes: Entlang der Fischtreppe führt ein schnuggliger etwas versteckter Weg zur Wertach runter. Zum Schluss eine kleine Kraxelei über Felsen. Auch nett für Kinder</desc>
    <src>Komoot</src>
    <link href="https://www.komoot.de/highlight/4202913">
      <text>View POI on Komoot</text>
    </link>
    <type>Highlight</type>
  </wpt>
