    <ele>934.6</ele>
    <name>Hiking Trail to Weißmainfelsen</name>
    <cmt>https://d2exd72xrrp1s7.cloudfront.net/www/000/1ka/1q/1q5pjcz9v94uq1sux0m9dj1arj5wgnb9t9-uhi106008300/0</cmt>
    <desc>Gerhard 1600   🍀🚴🍀: Schöner Wanderweg zum Weißmainfelsen</desc>
    <src>Komoot</src>
