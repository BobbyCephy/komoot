  <wpt lat="50.028752" lon="11.830704">
    <ele>954.8</ele>
    <name>Rest Area at Rock Formation in Naturpark Fichtelgebirge</name>
    <cmt>https://d2exd72xrrp1s7.cloudfront.net/www/000/1ka/1c/1cmzkrwocwkc777iyj6ab1vff5qmat0sx-uhi99495385/0</cmt>
    <desc>Gerhard 1600   🍀🚴🍀: herrlicher Rastplatz direkt unterhalb der Felsen</desc>
    <src>Komoot</src>
