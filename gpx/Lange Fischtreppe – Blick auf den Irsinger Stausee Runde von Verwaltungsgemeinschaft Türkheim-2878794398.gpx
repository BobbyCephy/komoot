  <wpt lat="48.017497" lon="10.650747">
    <ele>670.9</ele>
    <name>Eco Island Bad Wörishofen</name>
    <cmt>https://d2exd72xrrp1s7.cloudfront.net/www/000/1k6/po/po3u1981e5wp13x90qu1rxb0u41hmhc8c-uhi45909415/0</cmt>
