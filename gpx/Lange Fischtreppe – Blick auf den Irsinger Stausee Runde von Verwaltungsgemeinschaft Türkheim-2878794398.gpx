  <wpt lat="48.008041" lon="10.649583">
    <ele>621.7</ele>
    <name>Old channel of the Wertach near the Irsinger Reservoir</name>
    <cmt>https://d2exd72xrrp1s7.cloudfront.net/www/000/1k6/i1/i1ki2u5kskmh7vbq71b94kjx48fiyr3d-uhi51800551/0</cmt>
