  <wpt lat="48.749447" lon="11.27371">
    <ele>378.2</ele>
    <name>Vohburg Dam</name>
    <cmt>https://d2exd72xrrp1s7.cloudfront.net/www/000/1k3/1r/1r2mzkl74xug38b0xzcn5f1v2zfjmqkc-uhi5908735/0</cmt>
