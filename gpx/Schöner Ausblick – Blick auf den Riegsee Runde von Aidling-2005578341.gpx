  <wpt lat="47.708059" lon="11.230567">
    <ele>707.4</ele>
    <name>View of Lake Riegsee</name>
    <cmt>https://d2exd72xrrp1s7.cloudfront.net/www/000/1k5/mi/miav7iybzi761r5aw9h9nhlma3vp9zdhx-uhi39574826/0</cmt>
    <desc>Christoph Stoffel Bö: Schöner kleiner Steg von dem man gut auf den Riegsee blicken kann</desc>
