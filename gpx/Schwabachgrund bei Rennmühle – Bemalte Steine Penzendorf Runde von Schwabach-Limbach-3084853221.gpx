  <wpt lat="49.329987" lon="11.06539">
    <ele>364.3</ele>
    <name>Painted Stones Penzendorf</name>
    <cmt>https://d2exd72xrrp1s7.cloudfront.net/www/000/1k5/r9/r9wbtfqirrmm199i4sl0ew98s3t8i0jik-uhi35801751/0</cmt>
    <desc>Christian: An diesem Abschnitt des Jakobswegs sammeln die Pilger und Wanderer bemalte Steine. Eine tolle Aktion, die auch Kinder sicher zu kreativen Höchstleistungen anregt und jede Wanderung auflockert.
――――――――――
Incer: Leider sind nicht mehr viele da oder verwittert</desc>
    <src>Komoot</src>
    <link href="https://www.komoot.de/highlight/3370564">
      <text>View POI on Komoot</text>
    </link>
    <type>Highlight</type>
  </wpt>
