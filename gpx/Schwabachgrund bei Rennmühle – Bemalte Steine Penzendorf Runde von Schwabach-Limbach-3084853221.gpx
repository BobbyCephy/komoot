  <wpt lat="49.330967" lon="11.062916">
    <ele>400.5</ele>
    <name>Painted Rocks and Mushroom Stump in Wiesengrund Forest</name>
    <cmt>https://d2exd72xrrp1s7.cloudfront.net/www/000/1k5/dg/dgyrzte9d4508zfwku6b9uns40wdnlhx-uhi45464718/0</cmt>
    <desc>Incer: Leider sind die Steine schon verblasst und fast kein mehr da. Stand 04/2023</desc>
    <src>Komoot</src>
    <link href="https://www.komoot.de/highlight/1928879">
      <text>View POI on Komoot</text>
    </link>
