  <wpt lat="47.970548" lon="10.633113">
    <ele>681.5</ele>
    <name>Wertach Weir</name>
    <cmt>https://d2exd72xrrp1s7.cloudfront.net/www/000/1k5/hl/hlc6xwg7mwzunfsl9hr0vqo23tjyg1xv-uhi36252800/0</cmt>
    <desc>Chris: rauschendes Wasser lädt zum Rasten ein
――――――――――
Mike Fox: Eine kleine Staustufe oder besser Stolperstein für die Wertach.
――――――――――
Michael: Überlaufwehr</desc>
    <src>Komoot</src>
