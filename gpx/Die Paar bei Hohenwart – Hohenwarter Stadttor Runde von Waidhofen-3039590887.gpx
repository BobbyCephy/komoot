  <wpt lat="48.594284" lon="11.378947">
    <ele>455.1</ele>
    <name>Nikolaus-Weg Trailhead Information Board</name>
    <cmt>https://d2exd72xrrp1s7.cloudfront.net/www/000/1k5/k7/k7mo2mit68e4m482vypuilp3not1vh0-uhi28383940/0</cmt>
    <desc>Gitte 💠: Durch ein Leaderprojekt ist auch dieses wunderbare Wegenetz entstanden. Sehr übersichtlich und überschaubar.</desc>
