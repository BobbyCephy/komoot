    </link>
    <type>Highlight</type>
  </wpt>
  <wpt lat="47.455725" lon="10.760341">
    <ele>976.7</ele>
    <name>Playground at Lake Heiterwang</name>
    <cmt>https://d2exd72xrrp1s7.cloudfront.net/www/000/1k7/1u/1uktxkzwuejgpgw6p8una17mo4tuak8wr-uhi67928354/0</cmt>
    <desc>JR on Tour: Hier können sich die Kleinen austoben
――――――――――
Eric S. aus E.: Hier haben die Kinder definitiv ihren Spaß🎡🎠
――――――――――
Aki: Ein relativ neuer und toller Spielplatz</desc>
    <src>Komoot</src>
    <link href="https://www.komoot.de/highlight/4317408">
