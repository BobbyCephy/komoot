    <ele>429.5</ele>
    <name>Alte Burg Neuburg Ruins</name>
    <cmt>https://d2exd72xrrp1s7.cloudfront.net/www/000/1k4/wv/wvm1tphp0aea5qqpj1itiskr3hdc7hfa-uhi20237018/0</cmt>
