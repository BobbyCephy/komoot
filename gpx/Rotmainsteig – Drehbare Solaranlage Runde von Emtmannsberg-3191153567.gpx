  <wpt lat="49.889101" lon="11.629385">
    <ele>408.2</ele>
    <name>Path along the Red Main</name>
    <cmt>https://d2exd72xrrp1s7.cloudfront.net/www/000/1k9/m5/m5ix1itnclvb1ta9rtv1oxfbl5m0sb2fu-uhi96825257/0</cmt>
