  <wpt lat="48.45399" lon="11.061921">
    <ele>516</ele>
    <name>Großer Hieslinger Weiher</name>
    <cmt>https://d2exd72xrrp1s7.cloudfront.net/www/000/1k4/15/15pea3i3a5d43aqlnx0fqwy5w39srg05f-uhi10472926/0</cmt>
    <desc>Ivan Irrweg: Schöner Weiher, trotz der Straße angenehm ruhige Lage.
――――――――――
Di Rienzo S.: Toll anzuschauen.
――――――――――
Di Rienzo S.: Hier kann man sich mal richtig entspannen.
――――――――――
Bergwuffel: gefährlich
――――――――――
Werner Stra: Idyllischer Ort im Landkreis
――――――――――
Wolfgang-WS711: Idyllischer Weiher, obwohl Häuser ziemlich dicht an den Weiher gebaut
――――――――――
Gm: Natur pur, ruhige Gegend</desc>
    <src>Komoot</src>
    <link href="https://www.komoot.de/highlight/1107624">
      <text>View POI on Komoot</text>
    </link>
    <type>Highlight</type>
  </wpt>
