  <wpt lat="47.955856" lon="10.627632">
    <ele>693</ele>
    <name>Schlingener See</name>
    <cmt>https://d2exd72xrrp1s7.cloudfront.net/www/000/1k4/s7/s7h82l6332knebl6n932v6i93ganst64-uhi18035460/0</cmt>
    <desc>Hardi: Großer Wertach Stausee.
――――――――――
Basti: Schöner See mit toller Idylle bei Sonnenaufgang. Sehr naturbelassen.
――――――――――
Proflex Vintage: Natur pur direkt am Radweg. Es lohnt sich wirklich mal kurz abzusteigen und die Natur zu genießen
――――――――――
Dare2Bike: Schöne Landschaft mit wenig Trubel
――――――――――
Armin: Schöner naturbelassener kleiner See</desc>
    <src>Komoot</src>
    <link href="https://www.komoot.de/highlight/218221">
      <text>View POI on Komoot</text>
    </link>
    <type>Highlight</type>
  </wpt>
