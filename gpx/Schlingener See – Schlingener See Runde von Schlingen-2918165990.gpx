    <ele>684.7</ele>
    <name>Schlingener See</name>
    <cmt>https://d2exd72xrrp1s7.cloudfront.net/www/000/1k2/16/16ocetojdkc4fu22k2fdapy7q2k5ite23-uhi2464935/0</cmt>
    <desc>Basti: Toller Spot auf den See
――――――――――
Armin: Schöner kleiner naturbelassener See 👍</desc>
