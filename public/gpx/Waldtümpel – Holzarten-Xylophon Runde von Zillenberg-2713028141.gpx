  <wpt lat="48.28797" lon="11.07711">
    <ele>551.6</ele>
    <name>Forest pond</name>
    <cmt>https://d2exd72xrrp1s7.cloudfront.net/www/000/1k8/t9/t919vjnzmo1qvbmijhixwkm2521i1mcq-uhi75523298/0</cmt>
    <desc>Mareike: Halte die Augen auf: In diesem Tümpel sind Molche, Frösche und Kröten zu Hause.</desc>
    <src>Komoot</src>
    <link href="https://www.komoot.de/highlight/6819347">
      <text>View POI on Komoot</text>
    </link>
    <type>Highlight</type>
  </wpt>
  <wpt lat="48.29004" lon="11.072886">
    <ele>601</ele>
    <name>Höglwald Forest Climate Station</name>
    <cmt>https://d2exd72xrrp1s7.cloudfront.net/www/000/1k2/1w/1wbx91v5f88wc143b8jvd45aem2tcwbq4v-uhi4564565/0</cmt>
