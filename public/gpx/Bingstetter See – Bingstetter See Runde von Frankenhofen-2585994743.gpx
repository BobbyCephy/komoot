  <wpt lat="47.991101" lon="10.646">
    <ele>626.1</ele>
    <name>Bingstetter Lake</name>
    <cmt>https://d2exd72xrrp1s7.cloudfront.net/www/000/1k5/1r/1r6h56en42oiv5pk4az18bar23q6ge656-uhi31001688/0</cmt>
    <desc>Hermann: Ruhiges Wandergebiet und schöne Aussichten
――――――――――
Otti Vpunkt: Netter kleiner Stausee mit gutem rund Weg</desc>
    <src>Komoot</src>
    <link href="https://www.komoot.de/highlight/2711332">
      <text>View POI on Komoot</text>
    </link>
