  </wpt>
  <wpt lat="46.37235" lon="11.396669">
    <ele>1685</ele>
    <name>Forest Trail near Heidewiese</name>
    <cmt>https://d2exd72xrrp1s7.cloudfront.net/www/000/1k4/gv/gv4lrf0zq9fp1fi6wd5a9sx9c3fzdedtg-uhi17405256/0</cmt>
    <desc></desc>
    <src>Komoot</src>
    <link href="https://www.komoot.de/highlight/111023">
