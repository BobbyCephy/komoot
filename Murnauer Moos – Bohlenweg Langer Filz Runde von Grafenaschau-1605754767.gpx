  <wpt lat="47.652705" lon="11.133593">
    <ele>685.4</ele>
    <name>Iris Meadow in Murnauer Moos</name>
    <cmt>https://d2exd72xrrp1s7.cloudfront.net/www/000/1k5/1o/1og13aq5ku81y1vcfak779nesf3taa7eqe-uhi35901723/0</cmt>
