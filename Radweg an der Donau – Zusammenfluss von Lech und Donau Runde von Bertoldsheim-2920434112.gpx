  <wpt lat="48.734499" lon="10.984414">
    <ele>445.2</ele>
    <name>Danube Cycle Path</name>
    <cmt>https://d2exd72xrrp1s7.cloudfront.net/www/000/1k7/1j/1jb8rmj8ubqz8mdgfmwcjf02e4kr4dklz-uhi59998726/0</cmt>
    <desc>Günther🦎: Ein sehr schöner Radweg 
――――――――――
Klaus-S: Hier kann man entspannt Radeln
――――――――――
Andi: Auch hier führt der Donauradweg mal wieder direkt über den Dam. Läßt sich prima fahren und man sieht die Donau.</desc>
    <src>Komoot</src>
    <link href="https://www.komoot.de/highlight/3384803">
      <text>View POI on Komoot</text>
    </link>
    <type>Highlight</type>
  </wpt>
