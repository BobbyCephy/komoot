  <wpt lat="48.735838" lon="10.9398">
    <ele>396.2</ele>
    <name>Start of the Lech Cycle Path (Marxheim)</name>
    <cmt>https://d2exd72xrrp1s7.cloudfront.net/www/000/1k6/1n/1n9wn8znlv2cbtu441scojqgn4bdwyaqo-uhi54595658/0</cmt>
