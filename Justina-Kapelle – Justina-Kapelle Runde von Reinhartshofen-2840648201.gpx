  <wpt lat="48.218175" lon="10.721576">
    <ele>621.6</ele>
    <name>Deer in Front of Guggenberger Schloss</name>
    <cmt>https://d2exd72xrrp1s7.cloudfront.net/www/000/1k9/13/13tqg41d9ocq21pq6hrwoi56wu5efpsnmk-uhi87886955/0</cmt>
    <desc></desc>
    <src>Komoot</src>
